# Copy to .env and fill in. .env is gitignored and must never be committed.
# cmd:  copy .env.example .env

# --- Ingestion: market data source ---
MARKET_DATA_PROVIDER=alphavantage
ALPHAVANTAGE_API_KEY=
POLYGON_API_KEY=
TICKERS=AAPL,MSFT,GOOGL,AMZN,NVDA
INGEST_START_DATE=2025-01-01

# --- Storage (paths are inside the container, not on the host) ---
DUCKDB_PATH=/opt/airflow/data/warehouse/marketops.duckdb
RAW_ZONE_PATH=/opt/airflow/data/raw

# --- Postgres (pgvector store for the AI layer; Airflow's own metadata DB is
#     hardcoded to airflow:airflow@postgres in docker-compose.yaml) ---
POSTGRES_USER=marketops
POSTGRES_PASSWORD=
POSTGRES_DB=marketops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Airflow 3.x (names must match docker-compose.yaml exactly) ---
AIRFLOW_UID=50000
# Tag for the locally-built image; do not reuse the upstream apache/airflow tag.
AIRFLOW_IMAGE_NAME=marketops/airflow:dev
# docker compose run --rm airflow-cli python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__API_AUTH__JWT_SECRET=
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=
_PIP_ADDITIONAL_REQUIREMENTS=

# --- dbt ---
DBT_PROFILES_DIR=./dbt
DBT_TARGET=dev

# --- AI layer: LLM + embeddings ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0

# --- Eval harness ---
EVAL_JUDGE_MODEL=gpt-4o
EVAL_DATASET_PATH=evals/golden/incident_briefs.jsonl
