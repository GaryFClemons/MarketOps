# Copy to .env and fill in. .env is gitignored and must never be committed.
# cmd:  copy .env.example .env

# --- Ingestion: market data source ---
MARKET_DATA_PROVIDER=alphavantage
ALPHAVANTAGE_API_KEY=
POLYGON_API_KEY=
TICKERS=AAPL,MSFT,GOOGL,AMZN,NVDA
INGEST_START_DATE=2025-01-01

# --- Storage ---
DUCKDB_PATH=data/warehouse/marketops.duckdb
RAW_ZONE_PATH=data/raw

# --- Postgres (Airflow metadata + pgvector store) ---
POSTGRES_USER=marketops
POSTGRES_PASSWORD=
POSTGRES_DB=marketops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
# python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=

# --- dbt ---
DBT_PROFILES_DIR=./dbt
DBT_TARGET=dev

# --- AI layer: LLM + embeddings ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0

# --- Eval harness ---
EVAL_JUDGE_MODEL=gpt-4o
EVAL_DATASET_PATH=evals/golden/incident_briefs.jsonl
