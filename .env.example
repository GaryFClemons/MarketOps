# Copy to .env and fill in. .env is gitignored and must never be committed.
# cmd:  copy .env.example .env

# --- Ingestion: market data source ---
MARKET_DATA_PROVIDER=polygon
TICKERS=AAPL,ABNB,ADBE,ADI,ADP,ADSK,AEP,AMAT,AMD,AMGN,AMZN,ANSS,APP,ARM,ASML,AVGO,AXON,AZN,BIIB,BKNG,BKR,CDNS,CDW,CHTR,CTAS,GOOG,GOOGL,LIN,LRCX,LULU,MAR,MCHP,MDLZ,MELI,META,MNST,MRVL,MSFT,MSTR,MU,NFLX,NVDA,NXPI,ODFL,ON,ORLY,PANW,PAYX,PCAR,PDD,PEP,PLTR,PYPL,QCOM,QQQ,REGN,ROP,ROST,SBUX,SHOP,SNPS,SPY,TEAM,TMUS,TSLA,TTD,TTWO,TXN,VRSK,VRTX,WBD,WDAY,XEL,ZS
INGEST_START_DATE=2025-01-01

# --- Storage (paths are inside the container, not on the host) ---
DUCKDB_PATH=/opt/airflow/data/warehouse/marketops.duckdb
RAW_ZONE_PATH=/opt/airflow/data/raw


# --- Airflow 3.x (names must match docker-compose.yaml exactly) ---
AIRFLOW_UID=50000
# Tag for the locally-built image; do not reuse the upstream apache/airflow tag.
AIRFLOW_IMAGE_NAME=marketops/airflow:dev
# docker compose run --rm airflow-cli python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__API_AUTH__JWT_SECRET=
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=
_PIP_ADDITIONAL_REQUIREMENTS=

# --- dbt ---
DBT_PROFILES_DIR=./dbt
DBT_TARGET=dev

# --- AI layer: LLM + embeddings ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0

# --- Eval harness ---
EVAL_JUDGE_MODEL=gpt-4o
EVAL_DATASET_PATH=evals/golden/incident_briefs.jsonl
